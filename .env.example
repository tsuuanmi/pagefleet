# The dev server binds to loopback by default and has no required API credentials.
HOST=127.0.0.1
PORT=3088
DATA_DIR=./data
PUBLISHER=mock
# Never enable Meta without consent, Page IDs and server-side access tokens.
# PUBLISHER=meta
# META_PUBLISH_ENABLED=1
META_GRAPH_VERSION=v27.0
# META_PAGE_TOKEN_1=an-authorized-page-access-token
# For trusted LAN demo: npm start -- --demo --public --port 3088
# Set APP_PASSWORD (>=16 chars). LAN HTTP is not encrypted: no port forwarding.
# For VPS/public Internet: put HTTPS reverse proxy (e.g. Caddy) in front:
# HOST=0.0.0.0
# APP_PASSWORD=replace-with-a-unique-long-password
# PUBLIC_BASE_URL=https://pagefleet.example.com
# AI_PROVIDER can also be set per request in UI (template/openai/anthropic).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# Set current rates before enabling real generation, else cost shows as unknown:
# OPENAI_INPUT_USD_PER_M=
# OPENAI_OUTPUT_USD_PER_M=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
# ANTHROPIC_INPUT_USD_PER_M=
# ANTHROPIC_OUTPUT_USD_PER_M=
AI_MONTHLY_REQUEST_LIMIT=200
AI_MONTHLY_CAP_USD=5
